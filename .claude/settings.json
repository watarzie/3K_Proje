{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__postgres-salt-okunur__query"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(**/appsettings.Secrets.json)",
      "Edit(**/appsettings.Secrets.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -f:*)",
      "PowerShell(Remove-Item -Recurse -Force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/koruma.js\"",
            "timeout": 10,
            "statusMessage": "3K koruma kontrolü"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/crlf.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
